// Description:
// Jenkins pipeline to retrieve ABFS server (GCE) instance details.
// - Lists instances in CLOUD_ZONE filtered by SERVER_INSTANCE_PREFIX and prints
//   their status.
// - Requires env: CLOUD_ZONE, SERVER_INSTANCE_PREFIX. Uses gcloud and the
//   Jenkins K8s agent image.

pipeline {

  agent none

  environment {

    // Define Pod Template in environment so we can override storageClassName.
    def kubernetesPodTemplate = """
      apiVersion: v1
      kind: Pod
      spec:
        hostname: jenkins-abfs-server-details-pod
        serviceAccountName: ${JENKINS_SERVICE_ACCOUNT}
        containers:
        - name: abfs-server-details
          image: ${CLOUD_REGION}-docker.pkg.dev/${CLOUD_PROJECT}/${INFRA_DOCKER_ARTIFACT_PATH_NAME}:${INFRA_IMAGE_TAG}
          imagePullPolicy: Always
          command:
          - sleep
          args:
          - 5h
          tty: true
    """.stripIndent()
  }

  stages {
    stage ('Start Instance') {
      agent { kubernetes { yaml kubernetesPodTemplate } }
      stages {
        stage ('Server Details') {
          steps {
            script {
              currentBuild.description = "$BUILD_USER"
            }
            container(name: 'abfs-server-details') {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                sh '''
                  /usr/bin/env bash -euo pipefail <<'BASH'
                  # Strict mode for safer scripts:
                  # -e exit on error, -u error on unset vars, -o pipefail fail on pipeline errors

                  cd ./workloads/android/pipelines/environment/abfs/server_administration/get_server_details/

                  # List instances using gcloud's native filter and iterate safely.
                  instances=$(gcloud compute instances list --zones="${CLOUD_ZONE}" --format="value(name)" --filter="name~'${SERVER_INSTANCE_PREFIX}'" || true)
                  if [[ -z "$instances" ]]; then
                    echo "None"
                  else
                    while IFS= read -r instance; do
                      [[ -z "$instance" ]] && continue
                      echo; echo "\033[1;32mInstance $instance\033[0m"; echo
                      gcloud compute instances describe "$instance" --zone="${CLOUD_ZONE}"
                      echo; echo "\033[1;32mInstance $instance state: $(gcloud compute instances describe "$instance" --zone="${CLOUD_ZONE}" --format="value(status)")\033[0m"
                    done <<< "$instances"
                  fi
                '''
              }
            }
          }
        }
      }
    }
  }
}
