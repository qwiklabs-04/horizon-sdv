// Description:
// Jenkins pipeline to retrieve ABFS uploaders(s) (GCE) instance details.
// - Lists instances in CLOUD_ZONE filtered by UPLOADER_INSTANCE_PREFIX and prints
//   their status.
// - Requires env: CLOUD_ZONE, UPLOADER_INSTANCE_PREFIX. Uses gcloud and the
//   Jenkins K8s agent image.


pipeline {

  agent none

  environment {

    // Define Pod Template in environment so we can override storageClassName.
    def kubernetesPodTemplate = """
      apiVersion: v1
      kind: Pod
      spec:
        hostname: jenkins-abfs-uploader-details-pod
        serviceAccountName: ${JENKINS_SERVICE_ACCOUNT}
        containers:
        - name: abfs-uploader-details
          image: ${CLOUD_REGION}-docker.pkg.dev/${CLOUD_PROJECT}/${INFRA_DOCKER_ARTIFACT_PATH_NAME}:${INFRA_IMAGE_TAG}
          imagePullPolicy: Always
          command:
          - sleep
          args:
          - 5h
          tty: true
    """.stripIndent()
  }

  stages {
    stage ('Start Instance') {
      agent { kubernetes { yaml kubernetesPodTemplate } }
      stages {
        stage ('Uploader Details') {
          steps {
            script {
              currentBuild.description = "$BUILD_USER"
            }
            container(name: 'abfs-uploader-details') {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                sh '''
                  /usr/bin/env bash -euo pipefail <<'BASH'
                  # Strict mode for safer scripts:
                  # -e exit on error, -u error on unset vars, -o pipefail fail on pipeline errors

                  result=0
                  cd ./workloads/android/pipelines/environment/abfs/uploader_administration/get_uploader_details/

                  artifact() {
                    local file="${WORKSPACE}/${1}-status.txt"
                    tee >(sed -E 's/\\x1b\\[[0-9;]*[A-Za-z]//g' >> "$file")
                  }

                  abfs_liveness() {
                    [[ "$state" != "RUNNING" ]] && return
                    gcloud compute ssh --quiet --zone="${CLOUD_ZONE}" "$1" --tunnel-through-iap --command="" > /dev/null 2>&1 || true

                    { echo; echo "\033[1;32mABFS Process Liveness $1\033[0m"; } | artifact "$1"
                    PROCESS=$(gcloud compute ssh --quiet --zone="${CLOUD_ZONE}" "${1}" --tunnel-through-iap --command="pgrep -a abfs" || true)
                    if [ -n "${PROCESS}" ]; then
                      { echo; echo "\033[1;32mABFS Alive:\033[0m ${PROCESS}"; echo; } | artifact "$1"

                      BR_TAG=$(echo "${PROCESS}" | awk '{
                        grab=0; out=""
                        for (i=1;i<=NF;i++) {
                          if ($i ~ /^--branch(=|$)/) {
                            grab=1
                            if ($i ~ /^--branch=/) { sub(/^--branch=/,"",$i); out=$i }
                            continue
                          }
                          if (grab && $i ~ /^--project(\b|[-=])/) { print out; exit }
                          if (grab) { out = out (out?" ":"") $i }
                        }
                      }')
                      { echo; echo "\033[1;32mBranches/tags:\033[0m ${BR_TAG}"; echo; } | artifact "${1}"
                    else
                      { echo; echo "\033[1;31mABFS Not running, consider DESTROY and APPLY\033[0m"; echo; } | artifact "${1}"

                      # Dump useful logs
                      gcloud compute ssh --quiet --zone="${CLOUD_ZONE}" "${1}" --tunnel-through-iap --command="sudo cat /var/log/cloud-init.log" > "${WORKSPACE}"/"${1}"-cloud-init.log 2>&1 || true
                      gcloud compute ssh --quiet --zone="${CLOUD_ZONE}" "${1}" --tunnel-through-iap --command="sudo cat /var/log/cloud-init-output.log" > "${WORKSPACE}"/"${1}"-cloud-init-output.log 2>&1 || true
                      gcloud compute ssh --quiet --zone="${CLOUD_ZONE}" "${1}" --tunnel-through-iap --command="sudo journalctl" > "${WORKSPACE}"/"${1}"-journalctl.log 2>&1 || true

                      result=1
                    fi
                  }

                  # List instances using gcloud's native filter and iterate safely.
                  instances=($(gcloud compute instances list --zones="${CLOUD_ZONE}" --format="value(name)" --filter="name~'${UPLOADER_INSTANCE_PREFIX}'" || true))
                  if [ "${#instances[@]}" -gt 0 ]; then
                    for instance in "${instances[@]}"; do
                      [[ -z "$instance" ]] && continue
                      { echo; echo "\033[1;32mInstance $instance\033[0m"; } | artifact "$instance"; echo

                      gcloud compute instances describe "$instance" --zone="${CLOUD_ZONE}" | artifact "$instance"
                      state=$(gcloud compute instances describe "$instance" --zone="${CLOUD_ZONE}" --format="value(status)")
                      { echo; echo "\033[1;32mInstance $instance state: $state\033[0m"; } | artifact "$instance"
                      abfs_liveness "$instance" $state
                    done
                    echo "RESULT = $result"
                    exit "${result}"
                  else
                    echo "\033[1;33mNo instances matching ${UPLOADER_INSTANCE_PREFIX}\033[0m"
                  fi
                '''
              }
              archiveArtifacts artifacts: '*status*.txt', followSymlinks: false, onlyIfSuccessful: false, allowEmptyArchive: true
              archiveArtifacts artifacts: '*cloud-init*.log', followSymlinks: false, onlyIfSuccessful: false, allowEmptyArchive: true
              archiveArtifacts artifacts: '*journal*.log', followSymlinks: false, onlyIfSuccessful: false, allowEmptyArchive: true
            }
          }
        }
      }
    }
  }
}
