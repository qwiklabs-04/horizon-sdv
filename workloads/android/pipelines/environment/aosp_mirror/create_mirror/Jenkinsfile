// Description:
// This pipeline job provisions the AOSP Mirror resources and then triggers the downstream sync_mirror job to populate the mirror with official AOSP repositories at https://android.googlesource.com/mirror/manifest
//
// References:
//

// Function to create a json object for the .tfvars.json file (on the fly)
def buildTfvarsMap(env, params) {
  return [
    sdv_aosp_mirror_project_id: "${env.CLOUD_PROJECT}",
    sdv_aosp_mirror_region: "${env.CLOUD_REGION}",
    sdv_aosp_mirror_zone: "${env.CLOUD_ZONE}",
    sdv_aosp_mirror_network_name: "${env.AOSP_MIRROR_PRESET_NETWORK_NAME}",
    sdv_aosp_mirror_subnetwork_name: "${env.AOSP_MIRROR_PRESET_SUBNETWORK_NAME}"
  ]
}

pipeline {
  // Parameters defined in workloads/android/pipelines/environment/aosp_mirror/create_mirror/groovy/job.groovy

  agent {
    kubernetes {
      yaml """\
        apiVersion: v1
        kind: Pod
        metadata:
          name: jenkins-aosp-mirror-create-mirror-build-pod
          labels:
            aosp_mirror_build_pod: "true"
        spec:
          hostname: jenkins-aosp-mirror-create-mirror-build-pod
          serviceAccountName: ${TERRAFORM_WORKLOADS_SERVICE_ACCOUNT}
          containers:
          - name: aosp-mirror-create-mirror-builder-container
            image: ${CLOUD_REGION}-docker.pkg.dev/${CLOUD_PROJECT}/${AOSP_MIRROR_WORKLOADS_ENV_IMAGE_NAME}:${IMAGE_TAG}
            imagePullPolicy: IfNotPresent
            command:
            - sleep
            args:
            - 24h
            tty: true
      """.stripIndent()
    }
  }

  environment {
    // Define the tf backend bucket name from jenkins env var
    def tfBackendBucket = "${CLOUD_BACKEND_BUCKET}"

    // Define the .tfvars.json file name where AOSP Mirror tf directory is located
    def tfvarsJsonFilePath = "./workloads/android/pipelines/environment/aosp_mirror/terraform/create_mirror.tfvars.json"
    // this file is populated in stage `Create Mirror Operation`
  }

  options {
    // Prevent any other "write" operation pipeline within the AOSP Mirror domain
    // from running concurrently with this job (and vice-versa).
    buildBlocker(useBuildBlocker: true, blockLevel: 'GLOBAL', scanQueueFor: 'BUILDABLE', blockingJobs: '(?i)Android/Environment/AOSP-Mirror/.*/(create|delete|sync).*')

    // Prevent this specific job from running concurrently with itself.
    disableConcurrentBuilds()
  }
  
  stages {
    stage('Provision Mirror Resources') {
      steps {
        script {
          // Validate required parameters are provided
          if(!params.IMAGE_TAG?.trim()) {error("Required Parameter value NOT provided as input: IMAGE_TAG. An Image Tag for container is needed to use as environment for this job.")}
          if(!params.MIRROR_DIR?.trim()) {error("Required Parameter value NOT provided as input: MIRROR_DIR. A Mirror Directory name is needed.")}
          if(!params.MIRROR_MANIFEST_URL?.trim()) {error("Required Parameter value NOT provided as input: MIRROR_MANIFEST_URL. A Mirror Manifest URL is needed.")}
          if(!params.MIRROR_MANIFEST_REF?.trim()) {error("Required Parameter value NOT provided as input: MIRROR_MANIFEST_REF. A Mirror Manifest Ref is needed.")}
          if(!params.MIRROR_MANIFEST_FILE?.trim()) {error("Required Parameter value NOT provided as input: MIRROR_MANIFEST_FILE. A Mirror Manifest File is needed.")}
          
          currentBuild.description = "$BUILD_USER" + "<br/>" + "${params.MIRROR_DIR}" + "<br/>" + "${params.MIRROR_MANIFEST_URL}"

          echo 'Creating a new AOSP Mirror...'
          // Convert the tfvars map into valid json object and format it
          def tfvarsJson = groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(buildTfvarsMap(env, params)))
          // Write the content to a temporary .tfvars.json file within the tf directory
          writeFile(file: "${tfvarsJsonFilePath}", text: tfvarsJson)

          def scriptPath = "./workloads/android/pipelines/environment/aosp_mirror/create_mirror/create_mirror.sh"
          
          container(name: 'aosp-mirror-create-mirror-builder-container') {
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
              sh """
                chmod +x "${scriptPath}"
                ${scriptPath} ${tfBackendBucket} ${tfvarsJsonFilePath}
              """
              echo '[SUCCESS] AOSP Mirror resources created successfully.'
            }
          }
        }
      }
    }
    stage('Trigger Mirror Sync') {
      when {
        expression { return currentBuild.currentResult != 'FAILURE' }
      }
      steps {
        script {
          // Trigger the downstream job `Sync Mirror` to perform the initial mirror population
          echo 'Starting mirror sync via downstream job `Sync Mirror`...'
          def paramsList = []
          paramsList.add(string(name: 'IMAGE_TAG', value: "${params.IMAGE_TAG}"))
          paramsList.add(string(name: 'MIRROR_DIR', value: "${params.MIRROR_DIR}"))
          paramsList.add(string(name: 'MIRROR_MANIFEST_URL', value: "${params.MIRROR_MANIFEST_URL}"))
          paramsList.add(string(name: 'MIRROR_MANIFEST_REF', value: "${params.MIRROR_MANIFEST_REF}"))
          paramsList.add(string(name: 'MIRROR_MANIFEST_FILE', value: "${params.MIRROR_MANIFEST_FILE}"))
          
          def result = build job: 'Android/Environment/AOSP-Mirror/Sync Mirror',
                          parameters: paramsList,
                          wait: true,
                          propagate: true
          echo "Mirror sync finished with result: ${result.getResult()}"
        }
      }
    }
  }

  // Post-build actions for success or failure
  post {
    success {
      echo "Status: SUCCESS - AOSP Mirror creation job completed."
    }
    failure {
      echo "Status: FAILURE - AOSP Mirror creation job failed."
    }
    always {
      echo "Job finished."
    }
  }
}